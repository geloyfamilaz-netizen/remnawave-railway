# Все настройки проекта. В Railway ничего задавать не нужно: UUID создаётся сам
# (выводится из ID сервиса Railway, не меняется между деплоями). Свой: переменная UUID.
# Любую переменную можно переопределить через Railway Variables (она важнее этого файла).
# Формат: KEY=VALUE, комментарии начинаются с #. Секретов здесь нет (Reality-ключ выводится из UUID).

# ---- HTTPS-домен Railway (порт 8080): сайт-заглушка + пути прокси ----
# Каждый транспорт отключается значением 0.
ENABLE_WS=1
ENABLE_XHTTP=1
ENABLE_GRPC=1
WS_PATH=/ws
XHTTP_PATH=/xh
GRPC_SERVICE=grpc
# Отпечаток в клиентских ссылках: firefox | edge | android | safari | chrome
CLIENT_FP=firefox
# Свой нейтральный домен вместо *.up.railway.app (пусто = брать Railway-домен)
PUBLIC_DOMAIN=

# ---- Reality на TCP-прокси Railway ----
# Ключ выводится из UUID (смена UUID = новый ключ). Свой ключ: REALITY_PRIVATE_KEY (xray x25519).
ENABLE_REALITY=1
REALITY_DEST=www.microsoft.com:443
# REALITY_SNI по умолчанию = хост из REALITY_DEST
REALITY_SNI=
# Порты приложения для двух TCP-прокси в Railway Networking (0 = выключить)
REALITY_XHTTP_PORT=4443
REALITY_GRPC_PORT=5443
# Адреса TCP-прокси ровно как в Railway (host:port). Нужны, чтобы Reality-ссылки попали в подписку.
# Пример: TCP_PROXY_XHTTP=roundhouse.proxy.rlwy.net:12345
# Если у сервиса одна пара RAILWAY_TCP_PROXY_*, она подставится сама по порту приложения.
TCP_PROXY_XHTTP=
TCP_PROXY_GRPC=

# ---- Выход через Cloudflare WARP для выбранных сервисов (необязательно) ----
# Приватный ключ WARP_PRIVATE_KEY держите в Railway Variables, не в репозитории.
WARP_ADDRESS=172.16.0.2/32
WARP_RESERVED=
WARP_ENDPOINT=162.159.192.1:2408
# Теги geosite через запятую, например: openai,netflix
WARP_GEOSITES=

# ---- Страница и лента подписки (sub.py) ----
ENABLE_SUB=1
PROFILE_NAME=Railway
# Лимит устройств по заголовку x-hwid (0 = без лимита)
MAX_DEVICES=1
# Путь Railway Volume, чтобы привязка устройств переживала деплои (например /data)
STATE_DIR=
# Свои секретные пути (пусто = вычисляются из UUID и печатаются в логе)
SUB_PAGE_PATH=
SUB_FEED_PATH=

LOG_LEVEL=warning
