# Variables to set on the Railway "remnawave" service (Variables tab).
# Generate each secret with: openssl rand -hex 64

### APP ###
APP_PORT=3000
METRICS_PORT=3001
API_INSTANCES=1

### DATABASE (Railway Postgres service reference) ###
DATABASE_URL=${{Postgres.DATABASE_URL}}

### REDIS (Railway Redis service reference) ###
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}

### SECRETS (generate your own) ###
APP_SECRET=change_me
JWT_AUTH_SECRET=change_me
JWT_API_TOKENS_SECRET=change_me
METRICS_USER=admin
METRICS_PASS=change_me
# exactly 64 chars, a-z A-Z 0-9 only
WEBHOOK_SECRET_HEADER=change_me

### DOMAINS (your Railway public domain, no https://, no trailing slash) ###
FRONT_END_DOMAIN=${{RAILWAY_PUBLIC_DOMAIN}}
PANEL_DOMAIN=${{RAILWAY_PUBLIC_DOMAIN}}
SUB_PUBLIC_DOMAIN=${{RAILWAY_PUBLIC_DOMAIN}}/api/sub

### OPTIONAL ###
IS_DOCS_ENABLED=false
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
WEBHOOK_ENABLED=false
